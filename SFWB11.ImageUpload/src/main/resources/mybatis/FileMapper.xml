<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.app.mapper.FileMapper">

  <resultMap id="ItemMap" type="com.example.app.domain.Item">
    <id     column="id"      property="id"/>
    <result column="name"    property="name"/>
    <result column="img_src" property="imgSrc"/>
    <result column="memo"    property="memo"/>
  </resultMap>

  <select id="selectAll" resultMap="ItemMap">
    SELECT id, name, img_src, memo FROM gallery ORDER BY id DESC
  </select>

  <select id="selectById" parameterType="int" resultMap="ItemMap">
    SELECT id, name, img_src, memo FROM gallery WHERE id = #{id}
  </select>

  <insert id="insert" parameterType="com.example.app.domain.Item" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO gallery (name, img_src, memo)
    VALUES (#{name}, #{imgSrc}, #{memo})
  </insert>

  <update id="update" parameterType="com.example.app.domain.Item">
    UPDATE gallery
      SET name = #{name},
          img_src = #{imgSrc},
          memo = #{memo}
    WHERE id = #{id}
  </update>

  <delete id="deleteById" parameterType="int">
    DELETE FROM gallery WHERE id = #{id}
  </delete>
</mapper>